   "Scaffold(",
   "TopAppBar(",
   "NavigationBar(",
   "ModalBottomSheet(",
   "ModalNavigationDrawer(",
   "Dialog(",
   "AlertDialog(",
   "Snackbar("
  ]
 },
 "accessor": "\\b(AlmadarTheme|almadarTheme|MaterialTheme\\.|LocalAlmadar\\w*)\\b",
 "tokenRules": {
  "ios": [
   {
    "re": "\\bColor\\(",
    "rule": "raw Color(...) construction"
   },
   {
    "re": "\\.systemGray\\w*",
    "rule": "system gray literal"
   },
   {
    "re": "\\bColor\\.(gray|blue|red|green|yellow|orange|purple|pink|black|white|clear|primary|secondary|accentColor)\\b",
    "rule": "system Color.* literal"
   },
   {
    "re": "\\.padding\\(\\s*(\\.\\w+\\s*,\\s*)?\\d",
    "rule": "bare numeric .padding(<number>) literal"
   },
   {
    "re": "\\bCGFloat\\(\\s*-?(?:0*[1-9]\\d*(?:\\.\\d+)?|0*\\.\\d*[1-9]\\d*)\\s*\\)",
    "rule": "bare numeric CGFloat(<number>) layout literal"
   },
   {
    "re": "\\b(?:(?:min|max|ideal)(?:Width|Height)|width|height)\\s*:\\s*-?(?:0*[1-9]\\d*(?:\\.\\d+)?|0*\\.\\d*[1-9]\\d*)(?:[^\\w.]|$)",
    "rule": "bare numeric frame/width/height dimension literal"
   }
  ],
  "android": [
   {
    "re": "\\b[Cc][Oo][Ll][Oo][Rr]\\(0[xX]",
    "rule": "raw Color(0x...) hex construction"
   },
   {
    "re": "\\bColor\\(",
    "rule": "raw Color(...) construction"
   },
   {
    "re": "\\bColor\\.(Gray|LightGray|DarkGray|Blue|Red|Green|Yellow|Magenta|Cyan|Black|White)\\b",
    "rule": "system Color.* literal"
   },
   {
    "re": "\\b\\d+(\\.\\d+)?\\.(dp|sp)\\b",
    "rule": "bare numeric .dp/.sp literal"
   },
   {
    "re": "\\.padding\\(\\s*\\d",
    "rule": "bare numeric .padding(<number>) literal"
   },
   {
    "re": "\\bDp\\(\\s*-?(?:0*[1-9]\\d*(?:\\.\\d+)?|0*\\.\\d*[1-9]\\d*)f?\\s*\\)",
    "rule": "bare numeric Dp(<number>) layout literal"
   }
  ]
 },
